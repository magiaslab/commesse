# NextAuth
NEXTAUTH_SECRET=replace-with-strong-secret
NEXTAUTH_URL=http://localhost:3000

# Database (Neon Postgres - pooled)
# Usa l'endpoint pooler e abilita SSL e pgbouncer
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.neon.tech/db_name?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=30

# Resend (Email)
RESEND_API_KEY=re_place_api_key
RESEND_FROM=noreply@tuodominio.it
RESET_TOKEN_TTL_MINUTES=60

# Storage S3-compatible (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=commesse-docs
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
S3_FORCE_PATH_STYLE=false

# Base URL pubblica (per callback auth, link email, ecc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
